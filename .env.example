# Panel
PANEL_PORT=8080
PANEL_PUBLIC_URL=http://localhost:8080
ADMIN_USERNAME=admin
# Leave empty to generate a random password on first boot (printed once in the
# panel logs). Set a strong value here for unattended installs.
ADMIN_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
LOG_LEVEL=info
# Optional comma separated origins for frontend dev
CORS_ORIGINS=
# Optional comma separated IPs/CIDRs of reverse proxies whose
# X-Forwarded-For header may be trusted (e.g. 127.0.0.1,10.0.0.0/8).
TRUSTED_PROXIES=

# Optional: 32-byte hex/base64 key used to encrypt node certificate keys and
# DNS provider credentials. Leave empty to use DATA_DIR/cert.key.
CERT_ENC_KEY=

# Optional Redis: shared sessions, rate limits and cache.
# Leave REDIS_URL empty to use the in-memory fallback.
REDIS_URL=
REDIS_PREFIX=mikvace:
REDIS_REQUIRED=false

# Node agent (docker-compose.node.yml)
PANEL_URL=http://localhost:8080
NODE_TOKEN=
NODE_DATA_DIR=/var/lib/mikvace
