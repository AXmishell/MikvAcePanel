# API origin used by the browser.
# Keep the relative path for a same-origin reverse proxy / single binary.
# For a CDN or separate API domain use an absolute URL, e.g.
# VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api

# SPA base path.
# /panel/ for the default embedded deployment, / for a CDN root deployment.
VITE_BASE_PATH=/panel/

# Optional development proxy target used by `npm run dev`.
# VITE_DEV_API_TARGET=http://127.0.0.1:8080
