# ============================================================
# 面板模板 / Panel template
# 复制为 .env 后按需修改，供 docker-compose.yml 使用。
# Copy to .env and adjust as needed; used by docker-compose.yml.
# ============================================================

# ---------- 基础 / Basics ----------

# 面板在宿主机上的监听端口（容器内固定为 8080）。
# Port exposed on the Docker host (the container always listens on 8080).
PANEL_PORT=8080

# 面板公开访问地址，用于生成订阅链接和节点回调，必须是外部可达的地址。
# Public panel base URL used in subscription links and node callbacks.
PANEL_PUBLIC_URL=http://localhost:8080

# 是否由面板直接提供前端页面。默认开启；仅在前后端分离部署时设为 false。
# Serve the embedded frontend from the panel. Keep true unless the SPA is hosted separately.
SERVE_WEB=true

# 独立部署前端时的公开地址，仅在 SERVE_WEB=false 时用于根路径跳转。
# Public frontend origin used for root redirects when SERVE_WEB=false.
FRONTEND_URL=

# ---------- 管理员 / Admin account ----------

# 初始管理员用户名。
# Initial administrator username.
ADMIN_USERNAME=admin

# 初始管理员密码。留空则首次启动随机生成，并在日志中打印一次。
# Leave empty to generate a random password on first boot (printed once in the logs).
ADMIN_PASSWORD=

# ---------- 安全 / Security ----------

# JWT 签名密钥，建议至少 32 字节随机值：openssl rand -hex 32
# JWT signing secret; use at least 32 random bytes: openssl rand -hex 32
JWT_SECRET=

# 管理员会话有效期（小时），默认 24。
# Admin session lifetime in hours (default: 24).
SESSION_TTL_HOURS=24

# 允许跨域调用 API 的来源，逗号分隔；前后端同源时留空。
# Comma-separated browser origins allowed by CORS; leave empty for same-origin deployments.
CORS_ORIGINS=

# 可信反向代理的 IP/CIDR，逗号分隔；留空则不信任 X-Forwarded-For。
# Comma-separated IPs/CIDRs of trusted reverse proxies; empty ignores X-Forwarded-For.
# 例 / e.g.: 127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=

# 用于加密节点证书私钥和 DNS 凭据的 32 字节 hex/base64 密钥；留空则使用 DATA_DIR/cert.key。
# 32-byte hex/base64 key used to encrypt node certificate keys and DNS credentials.
# Leave empty to use DATA_DIR/cert.key.
CERT_ENC_KEY=

# ---------- 日志 / Logging ----------

# 日志级别：debug、info、warn、error。
# Log level: debug, info, warn or error.
LOG_LEVEL=info

# ---------- Redis（可选 / Optional）----------

# Redis 地址，用于共享会话、限流计数和缓存；留空则使用进程内存。
# Redis URL for sessions, rate limits and cache; leave empty to use process memory.
# 例 / e.g.: redis://127.0.0.1:6379/0
REDIS_URL=

# 所有 Redis 键的统一前缀。
# Prefix applied to every Redis key.
REDIS_PREFIX=mikvace:

# 为 true 时 Redis 连接失败将拒绝启动；默认 false，自动回退内存模式。
# true aborts startup when Redis is unreachable; false falls back to memory.
REDIS_REQUIRED=false

# ---------- 高级 / Advanced ----------
# 以下变量仅在直接运行面板二进制时使用，Docker Compose 已内置这些值。
# Only needed when running the panel binary directly; Docker Compose sets these already.
# ADDR=:8080
# DATA_DIR=./data
# DB_PATH=./data/panel.db
