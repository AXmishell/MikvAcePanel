# syntax=docker/dockerfile:1

# The build stage runs on the native builder platform and cross-compiles for the
# target, so multi-arch builds do not run the Go compiler under QEMU.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 \
    GOOS="${TARGETOS:-$(go env GOOS)}" \
    GOARCH="${TARGETARCH:-$(go env GOARCH)}" \
    go build -trimpath -buildvcs=false \
    -ldflags "-s -w -X github.com/axmishell/mikvacepanel/internal/version.Version=${VERSION} -X github.com/axmishell/mikvacepanel/internal/version.Commit=${COMMIT} -X github.com/axmishell/mikvacepanel/internal/version.BuildDate=${BUILD_DATE}" \
    -o /out/mikvace-node ./cmd/node

# Alpine is the runtime base because the agent needs iptables for port
# hopping and docker-cli for the sibling-container runtime. Pull the proxy
# binaries from their official images rather than relying on their (possibly
# distroless) userland.
FROM alpine:3.21
RUN apk add --no-cache ca-certificates iptables tzdata docker-cli
COPY --from=build /out/mikvace-node /usr/local/bin/mikvace-node
COPY --from=tobyxdd/hysteria:latest /usr/local/bin/hysteria /usr/local/bin/hysteria
COPY --from=ghcr.io/xtls/xray-core:latest /usr/local/bin/xray /usr/local/bin/xray
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/mikvace-node"]
