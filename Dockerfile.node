# syntax=docker/dockerfile:1

FROM golang:1.26-alpine AS build
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags "-s -w -X github.com/axmishell/mikvacepanel/internal/version.Version=${VERSION} -X github.com/axmishell/mikvacepanel/internal/version.Commit=${COMMIT} -X github.com/axmishell/mikvacepanel/internal/version.BuildDate=${BUILD_DATE}" \
    -o /out/mikvace-node ./cmd/node

# The official Hysteria image already contains bash, iptables, nftables and
# CA certificates, which the agent needs for port hopping and TLS.
FROM tobyxdd/hysteria:latest
RUN apk add --no-cache docker-cli
COPY --from=ghcr.io/xtls/xray-core:latest /usr/local/bin/xray /usr/local/bin/xray
COPY --from=build /out/mikvace-node /usr/local/bin/mikvace-node
ENV DATA_DIR=/data \
    HY2_RUNTIME=process \
    HYSTERIA_BIN=/usr/local/bin/hysteria \
    XRAY_BIN=/usr/local/bin/xray \
    XRAY_IMAGE=ghcr.io/xtls/xray-core:latest
VOLUME ["/data"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/mikvace-node"]
