# ============================================================
# 节点模板 / Node template
# 复制为 .env 后按需修改，供节点 Compose 文件使用。
# Copy to .env and adjust as needed; used by the node Compose files.
#
# 运行方式由所选 Compose 文件决定 / Runtime is selected by the Compose file:
#   docker compose -f docker-compose.node.yml up -d         # 进程模式 / process
#   docker compose -f docker-compose.node-docker.yml up -d  # Docker 模式 / docker
# ============================================================

# ---------- 连接面板 / Panel connection ----------

# 面板公开地址，节点必须能够访问（必填）。
# Panel base URL; the node must be able to reach it (required).
PANEL_URL=https://panel.example.com

# 节点 Token，在面板 节点 → 安装 中生成（必填）。
# Node token generated from Nodes → Install in the panel (required).
NODE_TOKEN=

# 面板使用自签名 HTTPS 证书时设为 true，跳过 TLS 校验。
# Set true to skip TLS verification when the panel uses a self-signed certificate.
PANEL_INSECURE=false

# ---------- 数据目录 / Data directory ----------

# 宿主机数据目录，保存配置、证书和运行状态，同时挂载到容器内 /data。
# 默认使用 Compose 文件所在目录下的 ./data-node，便于直接备份和迁移。
# Host data directory for configs, certificates and runtime state; mounted at /data.
# Defaults to ./data-node next to the Compose file for easy backups.
# Docker 模式（docker-compose.node-docker.yml）必须填写绝对路径。
# Docker mode requires an absolute path because the agent starts a sibling container.
NODE_DATA_DIR=./data-node

# ---------- Docker 模式 / Docker mode（仅 docker-compose.node-docker.yml）----------

# Hysteria 容器镜像，由 Agent 启动同机容器时使用。
# Hysteria container image used by the agent for sibling containers.
HY2_IMAGE=tobyxdd/hysteria:latest

# ---------- 日志 / Logging ----------

# 日志级别：debug、info、warn、error。
# Log level: debug, info, warn or error.
LOG_LEVEL=info
